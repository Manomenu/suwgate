{
    "name": "@maniumek/suwgate",
    "version": "0.0.0",
    "description": "One quality gate for every repository: suwgate check runs the steps of the repository's profiles and its guards, configured in suwgate.yml",
    "license": "MIT",
    "author": "Manomenu",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Manomenu/suwgate.git"
    },
    "type": "module",
    "bin": {
        "suwgate": "dist/cli.js"
    },
    "exports": {
        "./eslint": "./dist/eslint/index.js"
    },
    "files": [
        "dist",
        "schema"
    ],
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "changeset": "changeset",
        "release": "pnpm run build && changeset publish",
        "prepack": "pnpm run build"
    },
    "dependencies": {
        "ajv": "8.20.0",
        "yaml": "2.9.1"
    },
    "peerDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.4.4",
        "typescript-eslint": "^8.73.0"
    },
    "peerDependenciesMeta": {
        "@eslint/js": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "eslint-import-resolver-typescript": {
            "optional": true
        },
        "eslint-plugin-boundaries": {
            "optional": true
        },
        "typescript-eslint": {
            "optional": true
        }
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "eslint": "^10.15.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.4.4",
        "knip": "^6.46.1",
        "prettier": "^3.10.1",
        "publint": "0.3.25",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "5.1.1"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
