[Unit]
Description=Keep the machine from sleeping while the runner of %i runs a GitHub Actions job
Documentation=https://github.com/Manomenu/suwgate/blob/master/ci/self-hosted/README.md

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle:handle-lid-switch --who="CI runner %i" --why="A GitHub Actions job is running" --mode=block /usr/bin/sleep 6h
