{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://unpkg.com/@maniumek/suwgate/schema/suwgate.schema.json",
    "title": "suwgate.yml",
    "description": "The quality gate of a repository: its profiles, the steps it adds or skips, and the exceptions from the guards, each with its reason.",
    "type": "object",
    "additionalProperties": false,
    "required": ["profiles"],
    "properties": {
        "profiles": {
            "description": "What the repository is; each profile brings its default steps and guards.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["web", "library", "dotnet", "database"] }
        },
        "directories": {
            "description": "Where a profile's project lives when it is not the repository root, e.g. web: Myapp.Web.",
            "type": "object",
            "additionalProperties": false,
            "propertyNames": { "enum": ["web", "library", "dotnet", "database"] },
            "patternProperties": {
                "^": { "$ref": "#/$defs/relativePath" }
            }
        },
        "steps": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "add": {
                    "description": "Steps this repository runs on top of its profiles' steps.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "run"],
                        "properties": {
                            "name": { "$ref": "#/$defs/id", "description": "The step's id, unique among all steps." },
                            "run": { "type": "string", "minLength": 1, "description": "A bash command, run in the repository root." },
                            "title": { "type": "string", "minLength": 1, "description": "What the report calls the step." },
                            "quick": { "type": "boolean", "description": "Also run it in suwgate check --quick (default false)." },
                            "after": {
                                "type": "array",
                                "uniqueItems": true,
                                "items": { "$ref": "#/$defs/id" },
                                "description": "Steps that must finish first."
                            },
                            "limitSeconds": { "type": "integer", "minimum": 1, "description": "The step is killed above this." }
                        }
                    }
                },
                "skip": {
                    "description": "Steps of the profiles this repository does not run, each with its reason.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["step", "reason"],
                        "properties": {
                            "step": { "$ref": "#/$defs/id" },
                            "reason": { "$ref": "#/$defs/reason" }
                        }
                    }
                }
            }
        },
        "exceptions": {
            "description": "Exceptions from the guards: one target of one guard, each with its reason. suwgate check counts them.",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["guard", "target", "reason"],
                "properties": {
                    "guard": { "type": "string", "pattern": "^([a-z]+/)?[a-z][a-z0-9-]*$" },
                    "target": { "type": "string", "minLength": 1 },
                    "reason": { "$ref": "#/$defs/reason" }
                }
            }
        },
        "dev": {
            "description": "What suwgate dev needs to run the local stack of the repository: db, logs, smoke, server, tmux, checkout-env.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
                "name": {
                    "$ref": "#/$defs/id",
                    "description": "The short lower-case name of the app: the tmux session is <name>-dev, the database user, password and name default to it."
                },
                "portOffset": {
                    "description": "Added to every default port (server 6300, web 3300, e2e server 6301, e2e web 3301, database 5533, stack 8190), so repositories on one machine do not collide.",
                    "type": "integer",
                    "default": 0
                },
                "ports": {
                    "description": "One port set apart from the offset.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "server": { "$ref": "#/$defs/port", "description": "The dev server (dotnet watch), shown in its tmux pane." },
                        "web": { "$ref": "#/$defs/port", "description": "The web dev server (pnpm dev), shown in its tmux pane." },
                        "e2eServer": { "$ref": "#/$defs/port", "description": "The server of the browser tests in the main checkout." },
                        "e2eWeb": { "$ref": "#/$defs/port", "description": "The web server of the browser tests in the main checkout." },
                        "database": { "$ref": "#/$defs/port", "description": "The local PostgreSQL on the loopback." },
                        "stack": { "$ref": "#/$defs/port", "description": "The web of the compose stack, where suwgate dev smoke looks." }
                    }
                },
                "compose": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "file": { "$ref": "#/$defs/relativePath", "description": "The compose file (default compose.yaml)." },
                        "profile": { "type": "string", "minLength": 1, "description": "The compose profile of the database (default db)." },
                        "databaseService": { "type": "string", "minLength": 1, "description": "The PostgreSQL service (default db)." },
                        "serverService": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The server service that suwgate dev logs --compose reads (default server)."
                        },
                        "extraServices": {
                            "description": "Services started and stopped together with the database (a mail catcher).",
                            "type": "array",
                            "uniqueItems": true,
                            "items": { "type": "string", "minLength": 1 }
                        }
                    }
                },
                "database": {
                    "description": "Defaults to the app name for all three.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "user": { "type": "string", "minLength": 1 },
                        "password": {
                            "type": "string",
                            "minLength": 1,
                            "description": "A development password: the database is published on the loopback only."
                        },
                        "name": { "type": "string", "minLength": 1 }
                    }
                },
                "server": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "project": {
                            "$ref": "#/$defs/relativePath",
                            "description": "The folder of the server's .csproj (default directories.dotnet)."
                        },
                        "logFile": {
                            "$ref": "#/$defs/relativePath",
                            "description": "The server's JSON log, whose folder suwgate dev logs reads (default .artifacts/logs/server.jsonl)."
                        }
                    }
                },
                "smoke": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "checks": {
                            "description": "The requests of suwgate dev smoke (default /healthz and /api/health).",
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["path", "expect", "hint"],
                                "properties": {
                                    "path": { "type": "string", "pattern": "^/" },
                                    "expect": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "A regular expression the body must match on some line, next to status 200."
                                    },
                                    "hint": { "type": "string", "minLength": 1, "description": "What to look at when it fails." }
                                }
                            }
                        }
                    }
                }
            }
        },
        "settings": {
            "description": "Settings of a guard, by its id; the guard's own schema checks them.",
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }
        }
    },
    "$defs": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "reason": { "type": "string", "pattern": "\\S", "description": "Why: a sentence a reviewer can judge." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "relativePath": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" }
    }
}
