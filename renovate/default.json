{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [":disableDependencyDashboard"],
    "timezone": "Europe/Warsaw",
    "schedule": ["* 0-5 * * 1"],
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "merge-commit",
    "platformAutomerge": false,
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchPackageNames": ["*"],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest", "lockFileMaintenance"]
        },
        {
            "matchPackageNames": ["*"],
            "groupName": "all major dependencies",
            "groupSlug": "all-major",
            "matchUpdateTypes": ["major"]
        },
        {
            "matchPackageNames": [
                "Microsoft.AspNetCore.*",
                "Microsoft.Extensions.*",
                "Microsoft.EntityFrameworkCore*",
                "System.*",
                "dotnet-sdk",
                "mcr.microsoft.com/dotnet/**"
            ],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "matchPackageNames": ["dotnet-sdk"],
            "enabled": false
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["postgres", "docker.io/library/postgres", "**/postgres"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "matchFileNames": ["**/langfuse/**"],
            "enabled": false
        },
        {
            "matchManagers": ["pip_requirements"],
            "enabled": false
        },
        {
            "matchPackageNames": ["typescript"],
            "allowedVersions": ">=4.8.4 <6.1.0"
        },
        {
            "matchPackageNames": ["@maniumek/suwgate"],
            "postUpgradeTasks": {
                "commands": ["npx --yes @maniumek/suwgate@{{{newVersion}}} agents-shared"],
                "fileFilters": ["AGENTS.shared.md"],
                "executionMode": "update",
                "installTools": {
                    "node": {},
                    "npm": {}
                }
            }
        },
        {
            "matchPackageNames": ["csharpier"],
            "postUpgradeTasks": {
                "commands": ["dotnet tool restore", "dotnet csharpier format ."],
                "fileFilters": ["**/*.cs"],
                "executionMode": "branch",
                "installTools": {
                    "dotnet": {}
                }
            }
        }
    ]
}
