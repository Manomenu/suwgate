<Project>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' Or '$(TestProject)' == 'true'">
    <DefineConstants>$(DefineConstants);XUNIT_GENERATED_DISABLE_WARNINGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true' Or '$(TestProject)' == 'true'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)Suwgate.Architecture.Tests.globalconfig" />
  </ItemGroup>
</Project>
